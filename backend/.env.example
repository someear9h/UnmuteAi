# ========================================================
# Unmute AI - Environment Variables Template
# Copy this file to .env and fill in your API keys
# ========================================================

# Google Gemini API Key (Required for speech transcription & RAG intent reconstruction)
# Obtain from: https://aistudio.google.com/
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# ElevenLabs API Key (Required for realistic speech synthesis)
# Obtain from: https://elevenlabs.io/
ELEVENLABS_API_KEY=YOUR_ELEVENLABS_API_KEY_HERE

# Chroma Vector Database Configuration for RAG
CHROMA_PERSIST_DIRECTORY=./chroma_db
CHROMA_COLLECTION_NAME=unmute_user_context

# SQLite Database URL
DATABASE_URL=sqlite:///./test.db

# CORS Settings
ALLOWED_ORIGINS=*

